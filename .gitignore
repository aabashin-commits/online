# ⚠️ Комментарии — ТОЛЬКО на отдельной строке.
# Git не понимает комментарий в конце строки: «.env  # ключ» становится
# паттерном целиком вместе с решёткой и не срабатывает. На этом уже попались.

# Секреты и доступы — в репозиторий не отдаём НИКОГДА.
# .env — FIGMA_API_KEY; .vscode/ — sftp.json с паролем от FTP боевого сервера.
.env
.vscode/

# Локальная обвязка инструментов (абсолютные пути этой машины)
.mcp.json
.claude/
.playwright-mcp/

# Ролики (171 МБ) держим вне git: они раздуют историю навсегда,
# а на прод заливаются отдельно обычными файлами. См. README.md
assets/video/

# Мусор macOS и временные файлы
.DS_Store
_tmp-*
*-tmp.webp

# Копия старой версии сайта (снимок коммита 40ce47f), выгружена локально.
# В репозиторий не отдаём: она уже есть в истории git.
олд сайт/

# Локальные бэкапы CLAUDE.md перед правкой инструкций.
CLAUDE.md.bak-*

# Материалы клиента (аудит, ТЗ, списки правок) держим локально:
# их содержание уже пересказано в PLAN.md и checklist.md.
Аудит_и_ТЗ_онлайн-школа_LS*.md
Онлайн правки.md

# Макеты и фото правок от клиента (9,5 МБ) — тоже держим локально:
# что по ним сделано, записано в PLAN.md и docs/blocks.md.
корректировки сайта/
